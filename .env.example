# Kopieer naar .env en vul in. .env staat in .gitignore.

# Pad naar het JSON-sleutelbestand van je Google service account
# (zie docs/google-koppelen.md). Werkt voor Search Console en GA4.
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json

# Optioneel: API-sleutel voor PageSpeed Insights. Zonder sleutel werkt het ook,
# maar met een lage limiet.
PAGESPEED_API_KEY=

# Later: DataForSEO (nog niet in gebruik)
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
